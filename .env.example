# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
INGEST_PUBLIC_URL=http://localhost:4100
DATABASE_URL=postgres://lead@localhost:5434/lead_os
REDIS_URL=redis://localhost:6379
# 32+ random bytes; signs sessions, reply addresses and encrypts OAuth tokens
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# ---- WhatsApp Cloud API ----
# "cloud" for Meta Cloud API, "fake" for local development (no network, simulated statuses)
MESSAGING_PROVIDER=fake
WA_GRAPH_VERSION=v21.0
WA_APP_SECRET=
WA_VERIFY_TOKEN=dev-verify-token
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_FREE_SERVICE_ALLOWANCE=1000

# ---- Email ----
# Inbound parse domain (Postmark Inbound points here)
INBOUND_DOMAIN=inbox.doott.com
POSTMARK_INBOUND_USER=postmark
POSTMARK_INBOUND_PASSWORD=dev-inbound-password
# Our own company domains (internal forwards are attached as notes, not leads)
INTERNAL_DOMAINS=doott.com
SHARED_MAILBOXES=sales@doott.com,info@doott.com
# "ses" or "log" (log prints to console)
SYSTEM_MAIL_PROVIDER=log
SYSTEM_MAIL_FROM="Doott Sales <sales@mail.doott.com>"
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Gmail mailbox sync (Internal OAuth app) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
GOOGLE_PUBSUB_VERIFICATION_TOKEN=dev-pubsub-token
# Restrict Google SSO to this Workspace domain
GOOGLE_WORKSPACE_DOMAIN=doott.com

# ---- Website form intake ----
FORM_INTAKE_SECRET=dev-form-secret
# Per-IP limit. A website backend relaying submissions posts from one IP — keep this generous so a spike is never dropped.
FORM_RATE_LIMIT_PER_MIN=120

# ---- Object storage (R2 / S3 / MinIO). Empty = store on local disk under .devdata/storage ----
S3_ENDPOINT=
S3_BUCKET=lead-os
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
LOCAL_STORAGE_DIR=.devdata/storage

# ---- Web push (generate with: pnpm --filter @lead/api exec web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@doott.com

# ---- Doott enrichment (internal API). Empty = enrichment disabled ----
DOOTT_ENRICH_URL=
DOOTT_ENRICH_API_KEY=

# ---- Sentry ----
SENTRY_DSN=
